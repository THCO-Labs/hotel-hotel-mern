{
  "schemaVersion": 3,
  "templateSource": "hotel-booking-two",
  "templateVersion": "2.1.0",
  "framework": "vite-react-express-monorepo",
  "pageManifestDirectory": "page-manifests",
  "runtime": {
    "appRoot": "client",
    "packageManager": "npm",
    "install": "npm install",
    "dev": {
      "command": "npm run dev",
      "port": 5173,
      "readyPath": "/"
    },
    "entryPoint": "client/src/main.tsx",
    "typecheck": "npm run typecheck",
    "build": "npm run build",
    "start": "npm run start",
    "healthPath": "/api/health"
  },
  "database": {
    "required": true,
    "migrate": "npm run db:migrate",
    "seed": "npm run db:seed",
    "extensions": [
      "pgcrypto"
    ]
  },
  "branding": {
    "config": "client/src/config/brand.generated.json",
    "assets": "client/public"
  },
  "env": {
    "required": [
      "DATABASE_URL",
      "AUTH_SECRET"
    ]
  },
  "sharedModules": [
    "client/src/components",
    "client/src/config",
    "client/src/layouts",
    "server/src/common"
  ],
  "globalConfig": [
    "client/src/config/brand.generated.json",
    "client/src/config/site-content.json",
    "client/src/index.css"
  ],
  "verification": [
    "typecheck",
    "render"
  ],
  "protectedPaths": [
    "server/src/common/db",
    "server/src/modules/auth",
    "drizzle",
    "drizzle.config.ts",
    "package.json",
    "package-lock.json",
    "client/src/main.tsx",
    "client/src/router.tsx",
    "client/src/api",
    "client/src/hooks",
    "client/src/lib",
    "client/src/types",
    "client/src/layouts",
    "client/src/navigation",
    "client/src/config/app-config.ts",
    "client/src/components/ui",
    "client/src/components/brand-mark.tsx",
    "client/src/components/star-rating.tsx",
    "client/src/components/protected-route.tsx",
    "client/src/components/theme-provider.tsx",
    "client/src/components/theme-toggle.tsx"
  ],
  "editableSurfaces": [
    {
      "id": "site.brand",
      "kind": "CONFIG",
      "label": "Brand identity",
      "sourcePath": "client/src/config/brand.generated.json",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_ASSET"
      ],
      "fields": [
        {
          "path": "name",
          "label": "Business name",
          "type": "text"
        },
        {
          "path": "description",
          "label": "Description",
          "type": "rich_text"
        },
        {
          "path": "tagline",
          "label": "Tagline",
          "type": "text"
        },
        {
          "path": "logoPath",
          "label": "Logo",
          "type": "asset"
        }
      ]
    },
    {
      "id": "site.chrome",
      "kind": "CONFIG",
      "label": "Site header and footer",
      "page": "*",
      "sourcePath": "client/src/config/site-content.json",
      "operations": [
        "UPDATE_CONTENT"
      ],
      "fields": [
        {
          "path": "header.nav",
          "label": "Header navigation links",
          "type": "json"
        },
        {
          "path": "header.signIn",
          "label": "Sign-in button label",
          "type": "text"
        },
        {
          "path": "header.signUp",
          "label": "Sign-up button label",
          "type": "text"
        },
        {
          "path": "header.account",
          "label": "Guest account link label",
          "type": "text"
        },
        {
          "path": "header.dashboard",
          "label": "Staff dashboard link label",
          "type": "text"
        },
        {
          "path": "footer.note",
          "label": "Footer note",
          "type": "text"
        },
        {
          "path": "footer.links",
          "label": "Footer links",
          "type": "json"
        }
      ]
    },
    {
      "id": "dashboard.chrome",
      "kind": "CONFIG",
      "label": "Staff dashboard chrome",
      "page": "/dashboard/*",
      "sourcePath": "client/src/config/site-content.json",
      "operations": [
        "UPDATE_CONTENT"
      ],
      "fields": [
        {
          "path": "dashboard.workspaceLabel",
          "label": "Workspace header label",
          "type": "text"
        },
        {
          "path": "dashboard.signOut",
          "label": "Sign-out label",
          "type": "text"
        },
        {
          "path": "dashboard.groups.overview",
          "label": "Sidebar group: overview",
          "type": "text"
        },
        {
          "path": "dashboard.groups.operations",
          "label": "Sidebar group: operations",
          "type": "text"
        },
        {
          "path": "dashboard.groups.workspace",
          "label": "Sidebar group: workspace",
          "type": "text"
        },
        {
          "path": "dashboard.items.dashboard",
          "label": "Sidebar link: dashboard",
          "type": "text"
        },
        {
          "path": "dashboard.items.reservations",
          "label": "Sidebar link: reservations",
          "type": "text"
        },
        {
          "path": "dashboard.items.hotels",
          "label": "Sidebar link: hotels",
          "type": "text"
        },
        {
          "path": "dashboard.items.rooms",
          "label": "Sidebar link: rooms",
          "type": "text"
        },
        {
          "path": "dashboard.items.settings",
          "label": "Sidebar link: settings",
          "type": "text"
        }
      ]
    },
    {
      "id": "site.header",
      "kind": "COMPONENT",
      "label": "Site header",
      "page": "*",
      "sourcePath": "client/src/components/site-header.tsx",
      "selector": "[data-builder-id=site.header]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "site.footer",
      "kind": "COMPONENT",
      "label": "Site footer",
      "page": "*",
      "sourcePath": "client/src/components/site-footer.tsx",
      "selector": "[data-builder-id=site.footer]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "dashboard.navigation",
      "kind": "COMPONENT",
      "label": "Dashboard sidebar",
      "page": "/dashboard/*",
      "sourcePath": "client/src/components/dashboard-nav.tsx",
      "selector": "[data-builder-id=dashboard.navigation]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "theme.tokens",
      "kind": "DESIGN",
      "label": "Theme tokens",
      "sourcePath": "client/src/index.css",
      "operations": [
        "UPDATE_DESIGN_TOKEN"
      ],
      "fields": [
        {
          "path": "primary",
          "label": "Primary colour",
          "type": "color"
        },
        {
          "path": "radius",
          "label": "Corner radius",
          "type": "number"
        }
      ]
    },
    {
      "id": "homepage.hero",
      "kind": "COMPONENT",
      "label": "Homepage hero",
      "page": "/",
      "sourcePath": "client/src/pages/HomePage.tsx",
      "selector": "[data-builder-id=homepage.hero]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "UPDATE_ASSET",
        "CONFIGURE_COMPONENT",
        "CREATE_COMPONENT_VARIANT"
      ],
      "fields": [
        {
          "path": "headline",
          "label": "Headline",
          "type": "text"
        },
        {
          "path": "description",
          "label": "Description",
          "type": "rich_text"
        },
        {
          "path": "showSearch",
          "label": "Show search form",
          "type": "boolean"
        }
      ],
      "variants": [
        {
          "id": "centered",
          "label": "Centered"
        },
        {
          "id": "split-image",
          "label": "Split image"
        },
        {
          "id": "minimal",
          "label": "Minimal"
        }
      ]
    },
    {
      "id": "booking.search",
      "kind": "COMPONENT",
      "label": "Hotel search form",
      "page": "/",
      "sourcePath": "client/src/components/search-form.tsx",
      "selector": "[data-builder-id=booking.search]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "search.results",
      "kind": "COMPONENT",
      "label": "Search results",
      "page": "/search",
      "sourcePath": "client/src/pages/SearchPage.tsx",
      "selector": "[data-builder-id=search.results]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "hotel.details",
      "kind": "COMPONENT",
      "label": "Hotel details",
      "page": "/hotels/:slug",
      "sourcePath": "client/src/pages/HotelDetailsPage.tsx",
      "selector": "[data-builder-id=hotel.details]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "booking.form",
      "kind": "COMPONENT",
      "label": "Booking form",
      "page": "/booking",
      "sourcePath": "client/src/pages/BookingPage.tsx",
      "selector": "[data-builder-id=booking.form]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "booking.confirmation",
      "kind": "COMPONENT",
      "label": "Booking confirmation",
      "page": "/booking/confirmation/:reference",
      "sourcePath": "client/src/pages/ConfirmationPage.tsx",
      "selector": "[data-builder-id=booking.confirmation]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "lookup.form",
      "kind": "COMPONENT",
      "label": "Booking lookup",
      "page": "/lookup",
      "sourcePath": "client/src/pages/LookupPage.tsx",
      "selector": "[data-builder-id=lookup.form]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "auth.login",
      "kind": "COMPONENT",
      "label": "Sign-in page",
      "page": "/login",
      "sourcePath": "client/src/pages/LoginPage.tsx",
      "selector": "[data-builder-id=auth.login]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "auth.register",
      "kind": "COMPONENT",
      "label": "Sign-up page",
      "page": "/register",
      "sourcePath": "client/src/pages/RegisterPage.tsx",
      "selector": "[data-builder-id=auth.register]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "account.bookings",
      "kind": "COMPONENT",
      "label": "Guest account",
      "page": "/account",
      "sourcePath": "client/src/pages/AccountPage.tsx",
      "selector": "[data-builder-id=account.bookings]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "reservation.card",
      "kind": "COMPONENT",
      "label": "Reservation summary card",
      "page": "/lookup",
      "sourcePath": "client/src/features/booking/ReservationDetails.tsx",
      "selector": "[data-builder-id=reservation.card]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "dashboard.overview",
      "kind": "COMPONENT",
      "label": "Dashboard overview",
      "page": "/dashboard",
      "sourcePath": "client/src/pages/dashboard/DashboardPage.tsx",
      "selector": "[data-builder-id=dashboard.overview]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "dashboard.reservations",
      "kind": "COMPONENT",
      "label": "Reservations desk",
      "page": "/dashboard/reservations",
      "sourcePath": "client/src/pages/dashboard/ReservationsPage.tsx",
      "selector": "[data-builder-id=dashboard.reservations]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "dashboard.hotels",
      "kind": "COMPONENT",
      "label": "Hotel management",
      "page": "/dashboard/hotels",
      "sourcePath": "client/src/pages/dashboard/HotelsPage.tsx",
      "selector": "[data-builder-id=dashboard.hotels]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "dashboard.rooms",
      "kind": "COMPONENT",
      "label": "Room management",
      "page": "/dashboard/rooms",
      "sourcePath": "client/src/pages/dashboard/RoomsPage.tsx",
      "selector": "[data-builder-id=dashboard.rooms]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "dashboard.settings",
      "kind": "COMPONENT",
      "label": "Dashboard settings",
      "page": "/dashboard/settings",
      "sourcePath": "client/src/pages/dashboard/SettingsPage.tsx",
      "selector": "[data-builder-id=dashboard.settings]",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    }
  ],
  "pages": [
    {
      "id": "homepage",
      "manifest": "page-manifests/homepage/page.manifest.json"
    },
    {
      "id": "search",
      "manifest": "page-manifests/search/page.manifest.json"
    },
    {
      "id": "hotel-details",
      "manifest": "page-manifests/hotel-details/page.manifest.json"
    },
    {
      "id": "booking",
      "manifest": "page-manifests/booking/page.manifest.json"
    },
    {
      "id": "booking-confirmation",
      "manifest": "page-manifests/booking-confirmation/page.manifest.json"
    },
    {
      "id": "lookup",
      "manifest": "page-manifests/lookup/page.manifest.json"
    },
    {
      "id": "login",
      "manifest": "page-manifests/login/page.manifest.json"
    },
    {
      "id": "register",
      "manifest": "page-manifests/register/page.manifest.json"
    },
    {
      "id": "account",
      "manifest": "page-manifests/account/page.manifest.json"
    },
    {
      "id": "dashboard",
      "manifest": "page-manifests/dashboard/page.manifest.json"
    },
    {
      "id": "dashboard-reservations",
      "manifest": "page-manifests/dashboard-reservations/page.manifest.json"
    },
    {
      "id": "dashboard-hotels",
      "manifest": "page-manifests/dashboard-hotels/page.manifest.json"
    },
    {
      "id": "dashboard-rooms",
      "manifest": "page-manifests/dashboard-rooms/page.manifest.json"
    },
    {
      "id": "dashboard-settings",
      "manifest": "page-manifests/dashboard-settings/page.manifest.json"
    },
    {
      "id": "reservation-card",
      "manifest": "page-manifests/reservation-card/page.manifest.json"
    },
    {
      "id": "site-chrome",
      "manifest": "page-manifests/site-chrome/page.manifest.json"
    },
    {
      "id": "dashboard-chrome",
      "manifest": "page-manifests/dashboard-chrome/page.manifest.json"
    }
  ],
  "featureSlots": [
    {
      "id": "hotel.guest-experience",
      "label": "Guest experience",
      "supportedFeatures": [
        "reviews",
        "wishlists",
        "guest-profiles"
      ],
      "sourcePath": "client/src/features"
    },
    {
      "id": "hotel.operations",
      "label": "Hotel operations",
      "supportedFeatures": [
        "notifications",
        "coupons",
        "staff-reports"
      ],
      "sourcePath": "client/src/pages/dashboard"
    }
  ]
